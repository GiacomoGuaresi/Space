# Copia in .env.local e riempi: .env.local non finisce su git.
# Space usa il progetto Supabase di PRODUZIONE di Grocery, anche in sviluppo
# (doc/04, doc/08), nello schema `space`. In CI gli stessi valori stanno nelle
# variabili del repository GitHub.
# URL e chiave sono in Supabase → Project Settings → API Keys. La chiave
# publishable è pubblica per progettazione: i dati li proteggono le policy del
# database, non il segreto della chiave. Mai la chiave secret qui.

VITE_SUPABASE_URL=https://<riferimento-progetto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# L'email dell'account condiviso con le altre app (Authentication → Users):
# chi entra scrive solo la passphrase, che è la password di questo account.
VITE_SUPABASE_EMAIL=
